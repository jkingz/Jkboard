# Copy to .env.local and fill in the values.
# Every value here is a PLACEHOLDER. Do not deploy these as-is.

# Neon pooled connection string. Neon console -> Connection Details ->
# Connection string -> Pooled connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth signs and encrypts session cookies with this. It is NOT read by
# application code: Better Auth loads it from the environment itself, so a
# missing or placeholder value does not fail the build, it fails at sign-in.
#
# Generate a real one:  openssl rand -base64 32
# Must be identical across every environment that serves the same users, or
# existing sessions are invalidated on every deploy.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public origin of the deployment. Better Auth uses it for cookie origin
# checks and its trusted-origin list, so it must match where the app is
# actually served, including any preview-deployment URL.
# Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"